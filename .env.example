# ---- Required in production ---------------------------------------------------------------
# Random string, 32+ characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
# Public address. Use your domain (e.g. pdf.example.com) and Caddy fetches HTTPS certificates automatically.
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost
POSTGRES_PASSWORD=folio
MINIO_ROOT_USER=folio
MINIO_ROOT_PASSWORD=change-me-minio
BRAND_NAME=Folio

# ---- Privacy ------------------------------------------------------------------------------
FILE_TTL_HOURS=2

# ---- Sign-in (optional) -------------------------------------------------------------------
# Google OAuth client: redirect URI is ${PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMTP for magic links and invitations. Defaults to the bundled Mailpit (http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Folio <no-reply@example.com>

# ---- Payments (optional) ------------------------------------------------------------------
# Stripe webhook: ${PUBLIC_URL}/api/billing/webhooks/stripe (events: customer.subscription.*)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Razorpay webhook: ${PUBLIC_URL}/api/billing/webhooks/razorpay (events: subscription.*)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- AI (optional) ------------------------------------------------------------------------
# anthropic | openai (any OpenAI-compatible server, e.g. a local Ollama) | none
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-opus-5-5
AI_BASE_URL=
