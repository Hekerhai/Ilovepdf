  {
   "id": "watermark",
   "name": "Add watermark",
   "description": "Stamp text or an image over your pages, once or tiled.",
   "category": "edit",
   "accepts": [
    ".pdf"
   ],
   "min_files": 1,
   "max_files": null,
   "premium": false,
   "browser_capable": false,
   "produces_pdf": true,
   "options_schema": {
    "additionalProperties": false,
    "properties": {
     "text": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": "CONFIDENTIAL",
      "title": "Text"
     },
     "image": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Image as a data URL; used instead of text when set",
      "title": "Image"
     },
     "font_size": {
      "default": 48,
      "maximum": 400,
      "minimum": 4,
      "title": "Font Size",
      "type": "number"
     },
     "color": {
      "default": "#ef4444",
      "title": "Color",
      "type": "string"
     },
     "opacity": {
      "default": 0.3,
      "maximum": 1.0,
      "minimum": 0.02,
      "title": "Opacity",
      "type": "number"
     },
     "rotation": {
      "default": 45,
      "maximum": 180,
      "minimum": -180,
      "title": "Rotation",
      "type": "number"
     },
     "position": {
      "default": "center",
      "enum": [
       "top-left",
       "top-center",
       "top-right",
       "center",
       "bottom-left",
       "bottom-center",
       "bottom-right"
      ],
      "title": "Position",
      "type": "string"
     },
     "tiled": {
      "default": false,
      "description": "Repeat the watermark across the page",
      "title": "Tiled",
      "type": "boolean"
     },
     "image_scale": {
      "default": 0.4,
      "description": "Image width as a share of the page width",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "title": "Image Scale",
      "type": "number"
     },
     "pages": {
      "default": "all",
      "title": "Pages",
      "type": "string"
     }
    },
    "title": "Options",
    "type": "object"
