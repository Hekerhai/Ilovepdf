  {
   "id": "split",
   "name": "Split PDF",
   "description": "Split by page ranges, every N pages, file size or bookmarks.",
   "category": "organize",
   "accepts": [
    ".pdf"
   ],
   "min_files": 1,
   "max_files": 1,
   "premium": false,
   "browser_capable": true,
   "produces_pdf": true,
   "options_schema": {
    "$defs": {
     "SplitMode": {
      "enum": [
       "ranges",
       "every",
       "size",
       "bookmarks",
       "all"
      ],
      "title": "SplitMode",
      "type": "string"
     }
    },
    "additionalProperties": false,
    "properties": {
     "mode": {
      "$ref": "#/$defs/SplitMode",
      "default": "ranges",
      "description": "How to split"
     },
     "ranges": {
      "default": "1-1",
      "description": "Page ranges, one file per range, e.g. 1-3, 4-8, 9-",
      "title": "Ranges",
      "type": "string"
     },
     "every": {
      "default": 1,
      "description": "Pages per file (for 'every' mode)",
      "minimum": 1,
      "title": "Every",
      "type": "integer"
     },
     "max_size_mb": {
      "default": 5.0,
      "description": "Max size per file in MB (for 'size' mode)",
      "exclusiveMinimum": 0,
      "title": "Max Size Mb",
      "type": "number"
     },
     "merge_output": {
      "default": false,
      "description": "Put all extracted ranges into a single PDF",
      "title": "Merge Output",
      "type": "boolean"
     }
    },
    "title": "Options",
    "type": "object"
   }
  },
