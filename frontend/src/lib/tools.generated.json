  {
   "id": "organize",
   "name": "Organize PDF",
   "description": "Reorder, rotate, delete and add blank pages, across one or more files.",
   "category": "organize",
   "accepts": [
    ".pdf"
   ],
   "min_files": 1,
   "max_files": null,
   "premium": false,
   "browser_capable": true,
   "produces_pdf": true,
   "options_schema": {
    "$defs": {
     "PageRef": {
      "properties": {
       "file": {
        "default": 0,
        "description": "Index of the input file",
        "minimum": 0,
        "title": "File",
        "type": "integer"
       },
       "page": {
        "anyOf": [
         {
          "minimum": 1,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "description": "1-based page number; omit for a blank page",
        "title": "Page"
       },
       "rotate": {
        "default": 0,
        "enum": [
         0,
         90,
         180,
         270
        ],
        "title": "Rotate",
        "type": "integer"
       }
      },
      "title": "PageRef",
      "type": "object"
     }
    },
    "additionalProperties": false,
    "properties": {
     "pages": {
      "description": "The final page order",
      "items": {
       "$ref": "#/$defs/PageRef"
      },
      "minItems": 1,
      "title": "Pages",
      "type": "array"
     }
    },
    "required": [
     "pages"
    ],
    "title": "Options",
    "type": "object"
   }
  },
