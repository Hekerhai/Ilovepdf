{
  "manifest_version": 3,
  "name": "Open in Folio",
  "version": "1.0.0",
  "description": "Open any PDF link or the PDF you're viewing in Folio: read, compress, convert, edit or sign it in one click.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open in Folio",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["contextMenus", "storage", "activeTab"]
}
